{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "ignorePatterns": [
        "dist/**",
        "types/**",
        ".rollup.cache/**",
        "AGENTS.md",
        ".vscode/**",
        "site/dist/**",
        "site/.astro/**",
        "site/src/content/docs/api/**",
        "site/src/content/docs/ja/api/**",
        "site/src/content/docs/**/*.mdx",
        "site/src/content/docs/changelog.md",
        "site/src/content/docs/ja/changelog.md",
        "package-lock.json",
        "site/package-lock.json"
    ]
}
