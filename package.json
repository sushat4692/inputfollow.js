{
    "name": "inputfollow.js",
    "version": "0.2.0",
    "description": "Input Validate, Input Limit etc.",
    "keywords": [
        "form",
        "front-end",
        "typescript"
    ],
    "homepage": "https://github.com/sushat4692/inputfollow.js#readme",
    "bugs": {
        "url": "https://github.com/sushat4692/inputfollow.js/issues"
    },
    "license": "MIT",
    "author": "SUSH <sush@sus-happy.net>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sushat4692/inputfollow.js.git"
    },
    "directories": {
        "doc": "docs"
    },
    "files": [
        "package.json",
        "README.md",
        "LICENSE",
        "types",
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.es.js",
    "browser": "dist/inputfollow.js",
    "types": "types/index.d.ts",
    "scripts": {
        "prebuild": "rimraf dist && rimraf types && rimraf .rollup.cache && rimraf tsconfig.tsbuildinfo && rimraf temp",
        "build": "rollup -c",
        "postbuild": "mv ./dist/types ./types",
        "demo": "http-server ./demo",
        "make": "npm run build && npm run make:demo:build && npm run make:doc",
        "make:demo": "npm run build && npm run make:demo:build",
        "make:demo:build": "npm run make:demo:js && npm run make:demo:css",
        "make:demo:js": "cp -f ./dist/inputfollow.js ./demo/js/inputfollow.js && cp -f ./dist/inputfollow.js.map ./demo/js/inputfollow.js.map && cp -f ./dist/inputfollow.min.js ./demo/js/inputfollow.min.js",
        "make:demo:css": "sass demo/scss/style.scss demo/css/style.css --source-map",
        "make:doc": "api-extractor run --local --verbose && api-documenter markdown -i ./temp -o ./docs",
        "lint": "oxlint .",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser"
    },
    "devDependencies": {
        "@babel/core": "^7.28.4",
        "@babel/preset-env": "^7.28.3",
        "@microsoft/api-documenter": "^7.26.34",
        "@microsoft/api-extractor": "^7.52.13",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.4",
        "@vitest/browser-playwright": "^4.1.10",
        "http-server": "^14.1.1",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "playwright": "^1.62.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.52.0",
        "sass": "^1.93.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2",
        "vitest": "^4.1.10"
    }
}
