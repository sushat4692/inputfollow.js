{
    "name": "inputfollow.js",
    "version": "1.1.0",
    "description": "Input Validate, Input Limit etc.",
    "keywords": [
        "form",
        "front-end",
        "typescript"
    ],
    "homepage": "https://github.com/sushat4692/inputfollow.js#readme",
    "bugs": {
        "url": "https://github.com/sushat4692/inputfollow.js/issues"
    },
    "license": "MIT",
    "author": "SUSH <sush@sus-happy.net>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sushat4692/inputfollow.js.git"
    },
    "directories": {
        "doc": "site"
    },
    "files": [
        "package.json",
        "README.md",
        "LICENSE",
        "types",
        "dist"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.es.js",
    "browser": "dist/index.es.js",
    "types": "types/index.d.ts",
    "unpkg": "dist/inputfollow.min.js",
    "jsdelivr": "dist/inputfollow.min.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.es.js"
        },
        "./package.json": "./package.json",
        "./inputfollow.css": "./dist/inputfollow.css"
    },
    "scripts": {
        "prebuild": "rimraf dist && rimraf types && rimraf .rollup.cache && rimraf tsconfig.tsbuildinfo",
        "build": "rollup -c",
        "postbuild": "mv ./dist/types ./types && cp -f styles/inputfollow.css ./dist/inputfollow.css",
        "make": "npm run build && npm run docs:build",
        "make:doc": "npm run docs:build",
        "docs": "npm run docs:build",
        "docs:dev": "npm run changelog:sync && npm run dev --prefix site",
        "docs:build": "npm run changelog:sync && npm run build --prefix site",
        "docs:preview": "npm run preview --prefix site",
        "lint": "oxlint .",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser",
        "changelog:sync": "node scripts/sync-changelog.mjs",
        "changeset": "changeset",
        "changeset:status": "changeset status",
        "changeset:version": "changeset version && npm install --package-lock-only"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.3",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@vitest/browser-playwright": "^4.1.10",
        "jsdom": "^30.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "playwright": "^1.62.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.62.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    }
}
