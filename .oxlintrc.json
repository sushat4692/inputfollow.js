{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "browser": true,
        "node": true
    },
    "ignorePatterns": [
        "dist/**",
        "types/**",
        "docs/**",
        "temp/**",
        ".rollup.cache/**",
        "demo/js/inputfollow*.js",
        "demo/css/**",
        "demo/js/*.map"
    ],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "no-unused-vars": [
            "error",
            { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
        ],
        "no-undef": "off",
        "no-underscore-dangle": "off"
    }
}
